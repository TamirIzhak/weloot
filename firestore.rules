rules_version = '2';

// Default deny. Each collection gets explicit rules (and rules tests) in the issue that introduces it.
// See docs/PRD.md §8 for the data model and which fields are server-write only.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // App-wide settings the app reads (fees, limits, app status — PRD §8). Edited by ops in the console only.
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Profiles (PRD W1, §8) ──────────────────────────────────────────────────────────────────────────
    // A first sign-in writes one atomic batch: usernames/{lower} + users/{uid} + users/{uid}/private/settings.
    // Each rule checks the others with existsAfter/getAfter, so a username can't be claimed without a profile
    // (or twice), and a profile can't exist without its username claim. Edits come with #10, deletion with #11.

    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function usersPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function usernamePath(lower) {
      return /databases/$(database)/documents/usernames/$(lower);
    }

    function hasExactly(data, keys) {
      return data.keys().hasOnly(keys) && data.keys().hasAll(keys);
    }

    // Same as USERNAME_PATTERN in packages/shared/src/schemas.ts.
    function isUsername(s) {
      return s is string && s.matches('^[A-Za-z0-9_]{3,20}$');
    }

    // Same as PERSON_NAME_PATTERN in packages/shared/src/schemas.ts.
    function isPersonName(s) {
      return s is string && s.matches("^\\p{L}[\\p{L}\\p{M} '’.-]{0,39}$");
    }

    // Same as savedLocationSchema in packages/shared/src/schemas.ts (timestamps checked by the caller).
    function isSavedLocation(d) {
      return d.keys().hasAll(['label', 'address', 'lat', 'lng', 'areaName', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['label', 'address', 'lat', 'lng', 'cityId', 'areaName', 'createdAt', 'updatedAt'])
        && d.label is string && d.label.size() >= 1 && d.label.size() <= 30
        && d.address is string && d.address.size() >= 1 && d.address.size() <= 200
        && d.lat is number && d.lat >= 29 && d.lat <= 34
        && d.lng is number && d.lng >= 34 && d.lng <= 36
        && (!('cityId' in d) || (d.cityId is string && d.cityId.matches('^[1-9][0-9]{0,5}$')))
        && d.areaName is string && d.areaName.size() >= 1 && d.areaName.size() <= 60;
    }

    // Public profile: readable by everyone, guests included (listings show their owner).
    match /users/{uid} {
      allow read: if true;
      allow create: if signedInAs(uid)
        && hasExactly(request.resource.data, ['username', 'usernameLower', 'ratingAvg', 'ratingCount',
             'completedTrades', 'createdAt', 'updatedAt'])
        && isUsername(request.resource.data.username)
        && request.resource.data.usernameLower == request.resource.data.username.lower()
        // Trust signals start at zero; only Cloud Functions change them.
        && request.resource.data.ratingAvg == 0
        && request.resource.data.ratingCount == 0
        && request.resource.data.completedTrades == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && getAfter(usernamePath(request.resource.data.usernameLower)).data.uid == uid;
      allow update, delete: if false;

      // Saved addresses for posting (PRD W2): the owner only. Exact points never leave these docs; listings get an
      // area-level copy from the publish function.
      match /locations/{locationId} {
        allow read: if signedInAs(uid);
        allow create: if signedInAs(uid) && isSavedLocation(request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if signedInAs(uid) && isSavedLocation(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;
        allow delete: if signedInAs(uid);
      }

      // Private settings: the owner only. No phone number here either: it stays in Firebase Auth.
      match /private/settings {
        allow read: if signedInAs(uid);
        allow create: if signedInAs(uid)
          && request.resource.data.keys().hasAll(['preferredLanguage', 'tosVersion', 'tosAcceptedAt',
               'ageConfirmed', 'firstName', 'lastName', 'email', 'marketingOptIn', 'fcmTokens', 'blockedUserIds', 'searchRadiusKm',
               'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['preferredLanguage', 'tosVersion', 'tosAcceptedAt',
               'ageConfirmed', 'firstName', 'lastName', 'email', 'marketingOptIn', 'marketingOptInAt', 'fcmTokens', 'blockedUserIds',
               'searchRadiusKm', 'createdAt', 'updatedAt'])
          && request.resource.data.preferredLanguage in ['en', 'he']
          && request.resource.data.tosVersion is string
          && request.resource.data.tosVersion.size() > 0 && request.resource.data.tosVersion.size() <= 40
          && request.resource.data.tosAcceptedAt == request.time
          && request.resource.data.ageConfirmed == true
          // Private: chats get the names from a Cloud Function, never by reading this doc.
          && isPersonName(request.resource.data.firstName)
          && isPersonName(request.resource.data.lastName)
          // Same shape as emailSchema: lower-case, one @, a dot in the domain.
          && request.resource.data.email is string && request.resource.data.email.size() <= 254
          && request.resource.data.email.matches('^[^@\\sA-Z]+@[^@\\sA-Z]+\\.[^@\\sA-Z]+$')
          // Promotions only with explicit opt-in, recorded with the server time.
          && request.resource.data.marketingOptIn is bool
          && (request.resource.data.marketingOptIn
                ? request.resource.data.marketingOptInAt == request.time
                : !('marketingOptInAt' in request.resource.data))
          && request.resource.data.fcmTokens == []
          && request.resource.data.blockedUserIds == []
          && request.resource.data.searchRadiusKm is int
          && request.resource.data.searchRadiusKm >= 1 && request.resource.data.searchRadiusKm <= 200
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          // Created in the setup batch (or after it), never before the profile.
          && existsAfter(usersPath(uid));
        // Settings (PRD §9-D): language, search radius and the promotions opt-in. Opting in records the server
        // time; opting out removes it. Everything else (names, email, tokens, blocks) changes elsewhere.
        allow update: if signedInAs(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['preferredLanguage',
               'searchRadiusKm', 'marketingOptIn', 'marketingOptInAt', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && request.resource.data.preferredLanguage in ['en', 'he']
          && request.resource.data.searchRadiusKm is int
          && request.resource.data.searchRadiusKm >= 1 && request.resource.data.searchRadiusKm <= 200
          && request.resource.data.marketingOptIn is bool
          && (!request.resource.data.marketingOptIn
                ? !('marketingOptInAt' in request.resource.data)
                : resource.data.marketingOptIn
                  ? request.resource.data.marketingOptInAt == resource.data.marketingOptInAt
                  : request.resource.data.marketingOptInAt == request.time);
        allow delete: if false;
      }
    }

    // Username uniqueness guard: anyone can check whether a name is taken (single gets, no listing). Claimed
    // once, in the batch that creates the claimant's profile; never released by clients.
    match /usernames/{lower} {
      allow get: if true;
      allow create: if request.auth != null
        && hasExactly(request.resource.data, ['uid'])
        && request.resource.data.uid == request.auth.uid
        && !exists(usersPath(request.auth.uid))
        && getAfter(usersPath(request.auth.uid)).data.usernameLower == lower;
      allow update, delete: if false;
    }
  }
}
