{
  "name": "@weloot/rules-tests",
  "version": "0.0.0",
  "private": true,
  "description": "Firestore and Storage security rules tests, run against the Firebase emulators",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "firebase emulators:exec --config ../firebase.rules-tests.json --only firestore,storage --project demo-weloot \"jest --runInBand\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.0.0"
  }
}
