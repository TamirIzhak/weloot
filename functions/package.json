{
  "name": "@weloot/functions",
  "version": "0.0.0",
  "private": true,
  "description": "WeLoot Cloud Functions (Firebase, 2nd gen)",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=lib/index.js --packages=external --alias:@weloot/shared=../packages/shared/src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "firebase emulators:exec --config ../firebase.rules-tests.json --only firestore --project demo-weloot \"jest --runInBand\""
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
