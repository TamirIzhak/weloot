# App environment (copy to app/.env). Everything here is bundled into the app and is PUBLIC.
# Never put server secrets here — those live in Firebase Secret Manager (see README).

# dev | staging | prod
EXPO_PUBLIC_ENV=dev

# Firebase client config (public by design; access is enforced by Security Rules + App Check)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Social sign-in (#64): public IDs only; secrets live in the Firebase console / Secret Manager.
# Empty = the method isn't offered (development builds show it as "not set up yet"). See docs/OWNER-TODO.md.
# Google: the "Web client" OAuth client ID from Firebase (Authentication → Google → Web SDK configuration).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Facebook App ID (changing it needs a new dev build: it adds the fb<app id> URL scheme).
EXPO_PUBLIC_FACEBOOK_APP_ID=
# Discord application Client ID (also set DISCORD_CLIENT_ID in functions/.env).
EXPO_PUBLIC_DISCORD_CLIENT_ID=

# Algolia — search-only key, never the admin key
EXPO_PUBLIC_ALGOLIA_APP_ID=
EXPO_PUBLIC_ALGOLIA_SEARCH_KEY=

# Legal texts (docs/OWNER-TODO.md). Public URLs; "{lang}" is replaced with en or he. Empty = "Coming soon".
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=

# Support contact (international format without +, e.g. 9725XXXXXXXX)
EXPO_PUBLIC_SUPPORT_WHATSAPP=
EXPO_PUBLIC_SUPPORT_EMAIL=

# Development only: point the app at the local Firebase emulators (npm run emulators) instead of the
# dev project. The phone must be on the same Wi-Fi as this PC.
EXPO_PUBLIC_USE_EMULATORS=true
